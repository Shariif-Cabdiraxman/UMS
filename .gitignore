# ---------------------------------------------------------------------------
# Local configuration
#
# database.php holds the developer's own MySQL credentials. The repository
# ships database.example.php instead, so copy that file and edit it.
# ---------------------------------------------------------------------------
/config/database.php

# Create this file to switch on detailed error messages locally. It is never
# committed, so debugging cannot be left on by accident in a public checkout.
/config/debug.local.php

# Create this file to turn demonstration mode off, which stops the sign-in page
# advertising the seeded accounts. Demonstration mode is on by default.
/config/demo.off.local.php

# Local environment overrides
.env
.env.*

# ---------------------------------------------------------------------------
# Working notes
# ---------------------------------------------------------------------------
/HANDOFF.md

# ---------------------------------------------------------------------------
# Logs and temporary files
# ---------------------------------------------------------------------------
*.log
logs/
*.tmp
*.bak
*.orig
*~

# ---------------------------------------------------------------------------
# Editor and OS noise
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
Thumbs.db
desktop.ini
.DS_Store

# ---------------------------------------------------------------------------
# Dependencies and build output
#
# There is no build step and no package manager in this project. These are here
# so that an accidental node_modules or a bundled asset is never committed.
# ---------------------------------------------------------------------------
/node_modules/
/vendor/
